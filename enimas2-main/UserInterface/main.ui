          <property name="styleSheet">
           <string notr="true">QTreeView{
	background-color: #F5F5F5;
	border-width: 1;
	border-radius: 10px;
	border-style: solid;
	border-color: rgb(201, 201, 201);
}

/* Vertical line for siblings */
QTreeView::branch:has-siblings:!adjoins-item {
	border-image: url(./ui/icons/vline_qtreeview.png) 0;
}

/* Branch with more siblings */
QTreeView::branch:has-siblings:adjoins-item {
	border-image: url(./ui/icons/branch_more_qtreeview.png) 0;
}

/* Branch without siblings */
QTreeView::branch:!has-children:!has-siblings:adjoins-item {
	border-image: url(./ui/icons/branch_end_qtreeview.png) 0;
}

/* Branches without children */
QTreeView::branch:!has-children {
	image: none; /* No arrow is shown */
	margin: 0; /* Removes additional spacing */
	padding: 0; /* Removes additional spacing */
}

/* Branches with children (closed state) */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
	subcontrol-origin: padding;
	subcontrol-position: center left;
	padding-left: 5px;
	margin: 5px;
	image: url(./ui/icons/arrow_grey_qcombobox.png);
	width: 10px;
	height: 10px;
	border-image: none; /* Prevents any background lines*/
}

/* Brancges with children (open state) */
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
	subcontrol-origin: padding;
	subcontrol-position: center left;
	padding-left: 5px;
	margin: 7px;
	image: url(./ui/icons/right_arrow_grey_qtreeview.png);
	width: 10px;
	height: 10px;
	border-image: none; /* Prevents any background lines*/
}</string>
          </property>
